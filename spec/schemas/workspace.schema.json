{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EKK workspace binding 0.1",
  "type": "object",
  "required": [
    "schema",
    "workspace_id",
    "bindings"
  ],
  "properties": {
    "schema": {
      "const": "ekk.workspace/0.1"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 512
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "realm_alias",
          "realm_id",
          "contexts"
        ],
        "properties": {
          "realm_alias": {
            "type": "string",
            "minLength": 1
          },
          "realm_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 512
          },
          "contexts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 512
            },
            "minItems": 1
          },
          "working_entries": {
            "description": "Exact reading material; does not grant acceptance or access.",
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "required": [
                "realm",
                "id",
                "revision",
                "digest"
              ],
              "additionalProperties": false,
              "properties": {
                "realm": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 512
                },
                "id": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 512
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^(sha256:)?[0-9a-f]{64}$"
                }
              }
            }
          }
        },
        "additionalProperties": true
      }
    },
    "evidence_checks": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "path": {
            "type": "string",
            "description": "Owner-configured relative regular file; no parent traversal or symlinks."
          }
        }
      }
    },
    "assessment_actions": {
      "description": "Owner-declared assessment prerequisites; grants no execution authority. Check IDs must be configured and grounds must belong to the bound realm.",
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "id",
          "checks",
          "grounds",
          "completeness"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "grounds": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "required": [
                "realm",
                "id",
                "revision",
                "digest"
              ],
              "additionalProperties": false,
              "properties": {
                "realm": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 512
                },
                "id": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 512
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^(sha256:)?[0-9a-f]{64}$"
                }
              }
            }
          },
          "completeness": {
            "enum": [
              "complete",
              "incomplete",
              "unknown"
            ]
          },
          "max_age_seconds": {
            "type": "number",
            "minimum": 0,
            "default": 300
          }
        }
      }
    }
  },
  "additionalProperties": true
}
