{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ekk:schema:pack:0.1",
  "title": "EKK pack 0.1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "ekk.pack/0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "required": [
    "schema",
    "id",
    "version",
    "files"
  ],
  "additionalProperties": true
}
