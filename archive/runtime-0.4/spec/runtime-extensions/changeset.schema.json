{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ekk:schema:changeset:0.1",
  "title": "EKK changeset 0.1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "ekk.proposal/0.1"
    },
    "base": {
      "type": "string",
      "minLength": 1
    },
    "changes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(contexts|records|sources)/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ],
        "contentEncoding": "base64"
      }
    }
  },
  "required": [
    "schema",
    "base",
    "changes"
  ],
  "additionalProperties": true
}
